/**
 * Implements hook_entity_extra_field_info().
 *
 * "Voyage map" pseudo-fields, placed and ordered under Manage display like
 * any field: a voyage's itinerary, and all of a will's voyages combined
 * (with route toggles). Hidden by default, so only displays that place
 * them (the default ones) render a map.
 */
function eiw_core_entity_extra_field_info(): array {
  $extra['node']['eiw_voyage']['display']['eiw_voyage_map'] = [
    'label' => t('Voyage map'),
    'description' => t('The itinerary drawn as a route on a map.'),
    'weight' => 10,
    'visible' => FALSE,
  ];
  $extra['node']['eiw_will']['display']['eiw_voyage_map'] = [
    'label' => t('Voyage map'),
    'description' => t("All of the will's voyages drawn on one map, with toggles to show/hide each route."),
    'weight' => 10,
    'visible' => FALSE,
  ];
  return $extra;
}

/**
 * Implements hook_ENTITY_TYPE_view() for node entities.
 */
function eiw_core_node_view(array &$build, \Drupal\Core\Entity\EntityInterface $node, \Drupal\Core\Entity\Display\EntityViewDisplayInterface $display, string $view_mode): void {
  if ($node->uuid() === EIW_CORE_LANDING_PAGE_UUID && $view_mode === 'full') {
    eiw_core_landing_page_saml_notice($build);
  }
  if ($node->uuid() === EIW_CORE_VOYAGES_SHIPS_PAGE_UUID && $view_mode === 'full') {
    eiw_core_voyages_ships_lists($build);
  }
  if (!$display->getComponent('eiw_voyage_map')) {
    return;
  }
  $voyages = [];
  if ($node->bundle() === 'eiw_voyage') {
    $voyages[] = ['voyage' => $node];
  }
  elseif ($node->bundle() === 'eiw_will') {
    // One route per voyage the testator sailed on, labelled with the ship
    // where known (a voyage name alone is often ambiguous).
    foreach ($node->get('field_will_voyages')->referencedEntities() as $will_voyage) {
      $voyage = $will_voyage->get('field_voyage')->entity;
      if (!$voyage || isset($voyages[$voyage->id()])) {
        continue;
      }
      $ship = $will_voyage->get('field_ship')->entity;
      $voyages[$voyage->id()] = [
        'voyage' => $voyage,
        'label' => $ship ? t('@voyage (@ship)', ['@voyage' => $voyage->label(), '@ship' => $ship->label()]) : $voyage->label(),
      ];
    }
  }
  if ($voyages && ($map = \Drupal::service('eiw_core.voyage_map_builder')->build(array_values($voyages)))) {
    $build['eiw_voyage_map'] = $map;
  }
}

/**
 * Adds the "sign in with SAML" notice to the landing page for anonymous users.
 *
 * The landing page is the only page anonymous visitors can see (see
 * AnonymousAccessSubscriber), so it carries the notice saml_features
 * normally shows on the login form. It's rendered as a regular warning
 * status message so it looks the same, but built into the page itself
 * rather than queued with the messenger, which wouldn't survive the page
 * being cached for anonymous users.
 *
 * @see saml_features_form_user_login_form_alter()
 */
function eiw_core_landing_page_saml_notice(array &$build): void {
  $build['#cache']['contexts'][] = 'user.roles:anonymous';
  if (!\Drupal::currentUser()->isAnonymous()) {
    return;
  }
  $saml_config = \Drupal::config('saml_features.adminsettings');
  $build['#cache']['tags'][] = 'config:saml_features.adminsettings';
  $build['eiw_saml_notice'] = [
    '#theme' => 'status_messages',
    '#message_list' => [
      'warning' => [
        t('<strong>@institution accounts</strong> must sign in using <strong>@auth_link</strong>.', [
          '@institution' => $saml_config->get('exclude_stu') ? 'UNB' : 'UNB/STU',
          '@auth_link' => Link::fromTextAndUrl(t('Secure Services Login'), Url::fromRoute('samlauth.saml_controller_login'))->toString(),
        ]),
      ],
    ],
    '#status_headings' => ['warning' => t('Access restricted (under development)')],
    '#weight' => -100,
  ];
}

/**
 * Builds the /wills search box shown on the landing page.
 *
 * It's the wills view's own exposed form, so it submits to /wills with the
 * same query parameter as searching there. The "Show All" reset button is
 * left out: there's nothing to reset on the landing page. The theme places
 * it between the hero engraving and the page title (see
 * eastindiawills_unb_lib_ca_preprocess_page()).
 *
 * @return array
 *   A render array; empty but for cacheability if the user can't search.
 */
function eiw_core_wills_search_box(): array {
  $build = ['#cache' => ['tags' => ['config:views.view.wills']]];
  $view = Views::getView('wills');
  if (!$view || !$view->access('page_1')) {
    $build['#cache']['contexts'][] = 'user.permissions';
    return $build;
  }
  $view->setDisplay('page_1');
  $view->initHandlers();
  $form = $view->display_handler->getPlugin('exposed_form')->renderExposedForm(TRUE);
  if (!$form) {
    return $build;
  }
  unset($form['actions']['reset']);
  if (isset($form['actions']['submit'])) {
    $form['actions']['submit']['#value'] = t('Search');
  }
  if (isset($form['search_api_fulltext'])) {
    $form['search_api_fulltext']['#title'] = t('Search the wills');
  }
  return $build + [
    '#type' => 'container',
    '#attributes' => ['class' => ['eiw-home-search']],
    'form' => $form,
  ];
}

/**
 * Lists the voyages and ships on the "Voyages and Ships" page.
 *
 * Two columns after the page's editable preamble: every published voyage
 * (by title, which starts with its year, so in date order) and ship (by
 * name), each linking to its page. The placeholder "Unknown" records that
 * wills point at when the voyage or ship isn't known are left out.
 *
 * Voyages are imported unpublished for editors to review, so the lists
 * aren't limited to published records: each viewer sees the ones they can
 * open, with unpublished ones marked as such.
 */
function eiw_core_voyages_ships_lists(array &$build): void {
  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $cacheability = (new CacheableMetadata())
    ->addCacheTags(['node_list'])
    ->addCacheContexts(['user.permissions']);
  $lists = [];
  foreach (['eiw_voyage' => t('Voyages'), 'eiw_ship' => t('Ships')] as $bundle => $title) {
    $ids = $storage->getQuery()
      ->accessCheck(TRUE)
      ->condition('type', $bundle)
      ->condition('title', 'Unknown', '<>')
      ->sort('title')
      ->execute();
    $items = [];
    foreach ($storage->loadMultiple($ids) as $node) {
      $access = $node->access('view', NULL, TRUE);
      $cacheability->addCacheableDependency($access);
      if (!$access->isAllowed()) {
        continue;
      }
      $item = ['link' => $node->toLink()->toRenderable()];
      if (!$node->isPublished()) {
        $item['unpublished'] = [
          '#markup' => ' <span class="eiw-voyages-ships__unpublished">(' . t('unpublished') . ')</span>',
        ];
      }
      $items[] = $item;
    }
    $lists[$bundle] = [
      'title' => $title,
      'count' => count($items),
      'items' => $items,
    ];
  }
  $build['eiw_voyages_ships'] = [
    '#theme' => 'eiw_voyages_ships',
    '#lists' => $lists,
    '#weight' => 50,
  ];
  $cacheability->applyTo($build['eiw_voyages_ships']);
}
