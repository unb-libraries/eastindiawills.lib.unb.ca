{#
/**
 * @file
 * Renders a will's voyages as a Voyage | Ship | Role table.
 *
 * Applies when the voyages are rendered in the paragraph "table_row" view
 * mode (paragraph--eiw-will-voyage--table-row.html.twig gives one <tr> per
 * voyage): the will page (default display) and the will_voyages view mode
 * that's indexed into Solr for the /wills results column. Any other
 * rendering falls back to the plain field markup.
 *
 * Modifier classes on the table drive the styling in _wills.scss:
 * - eiw-voyages--multiple: more than one voyage, so rows are numbered.
 * - eiw-voyages--no-voyage/-ship/-role: that column is empty for every
 *   voyage, so it's dropped rather than shown as a column of dashes.
 */
#}
{%
  set classes = [
    'field',
    'field--name-' ~ field_name|clean_class,
    'field--type-' ~ field_type|clean_class,
    'field--label-' ~ label_display,
  ]
%}
{%
  set title_classes = [
    'field__label',
    label_display == 'visually_hidden' ? 'visually-hidden',
  ]
%}
{% set as_table = items|first.content['#view_mode'] == 'table_row' %}
<div{{ attributes.addClass(classes) }}>
  {% if not label_hidden %}
    <div{{ title_attributes.addClass(title_classes) }}>{{ label }}</div>
  {% endif %}
  {% if as_table %}
    {% set has = {voyage: false, ship: false, role: false} %}
    {% for item in items %}
      {% set paragraph = item.content['#paragraph'] %}
      {% for column in ['voyage', 'ship', 'role'] %}
        {% if not paragraph.get('field_' ~ column).isEmpty() %}
          {% set has = has|merge({(column): true}) %}
        {% endif %}
      {% endfor %}
    {% endfor %}
    {%
      set table_classes = [
        'table',
        'eiw-voyages',
        items|length > 1 ? 'eiw-voyages--multiple',
        not has.voyage ? 'eiw-voyages--no-voyage',
        not has.ship ? 'eiw-voyages--no-ship',
        not has.role ? 'eiw-voyages--no-role',
      ]
    %}
    <table class="{{ table_classes|join(' ')|trim }}">
      <thead>
        <tr>
          <th scope="col" class="eiw-voyages__num"><span class="visually-hidden">{{ 'Number'|t }}</span></th>
          <th scope="col" class="eiw-voyages__voyage">{{ 'Voyage'|t }}</th>
          <th scope="col" class="eiw-voyages__ship">{{ 'Ship'|t }}</th>
          <th scope="col" class="eiw-voyages__role">{{ 'Role'|t }}</th>
        </tr>
      </thead>
      <tbody>
        {% for item in items %}
          {{ item.content }}
        {% endfor %}
      </tbody>
    </table>
  {% else %}
    <div class="field__items">
      {% for item in items %}
        <div{{ item.attributes.addClass('field__item') }}>{{ item.content }}</div>
      {% endfor %}
    </div>
  {% endif %}
</div>
