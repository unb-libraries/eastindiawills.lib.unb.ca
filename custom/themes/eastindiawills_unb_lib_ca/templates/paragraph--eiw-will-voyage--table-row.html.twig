{#
/**
 * @file
 * One will voyage as a table row (paragraph "table_row" view mode, whose
 * display hides the field labels). The table and its Voyage | Ship | Role
 * header come from field--field-will-voyages.html.twig.
 */
#}
<tr{{ attributes.addClass('eiw-voyages__row') }}>
  <td>{{ content.field_voyage }}</td>
  <td>{{ content.field_ship }}</td>
  <td>{{ content.field_role }}</td>
</tr>
