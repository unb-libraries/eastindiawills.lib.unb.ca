<?php

use Drupal\Component\Utility\Html;
use Drupal\Core\Cache\CacheableMetadata;
use Drupal\Core\Entity\FieldableEntityInterface;
use Drupal\Core\Render\BubbleableMetadata;
use Drupal\Core\Render\Markup;

/**
 * @file
 * East India Wills theme file.
 */

/**
 * Implements hook_views_post_render().
 */
function eastindiawills_unb_lib_ca_views_post_render($view, &$output, &$cache) {
  if ($view->id() === 'audit_wills' && $view->current_display === 'page_1') {
    // If there are no results.
    if (empty($view->result)) {
      // Override the title after all other processing.
      $view->setTitle('Audit Wills');
      // You may also need to directly override $output['#title'] if the above doesn't work:
      $output['#title'] = 'Audit Wills';
    }
  }
}
/**
 * Implements hook_preprocess_HOOK() for menu--main.html.twig.
 *
 * Marks main menu links pointing at the current route as active, so the
 * header can underline the current section regardless of query strings
 * (e.g. facet filters on /wills).
 */
function eastindiawills_unb_lib_ca_preprocess_menu__main(&$variables) {
  $current_route = \Drupal::routeMatch()->getRouteName();
  foreach ($variables['items'] as &$item) {
    if ($item['url']->isRouted() && $item['url']->getRouteName() === $current_route) {
      $item['in_active_trail'] = TRUE;
    }
  }
  $variables['#cache']['contexts'][] = 'route.name';
}

/**
 * Implements hook_preprocess_HOOK() for page.html.twig.
 *
 * The wills search page follows the concept design: no breadcrumb.
 *
 * The hero engraving (see page.html.twig's eiw_hero block) belongs on the
 * homepage per the concept design - specifically the landing page node
 * eiw_core creates (EIW_CORE_LANDING_PAGE_UUID), not just any node of its
 * "page" type (e.g. a future "About this site" page shouldn't get it too).
 */
function eastindiawills_unb_lib_ca_preprocess_page(&$variables) {
  $route_match = \Drupal::routeMatch();
  if ($route_match->getRouteName() === 'view.wills.page_1') {
    unset($variables['page']['breadcrumb']);
  }
  elseif ($route_match->getRouteName() === 'entity.node.canonical') {
    $node = $route_match->getParameter('node');
    if ($node instanceof \Drupal\node\NodeInterface && $node->uuid() === EIW_CORE_LANDING_PAGE_UUID) {
      $variables['eiw_hero'] = TRUE;
    }
  }
  $variables['#cache']['contexts'][] = 'route.name';
}

/**
 * Implements hook_preprocess_HOOK() for views-view-field.html.twig.
 *
 * The wills listing's title is always "{Surname}, {Given name} [ {date} ]"
 * (the given name and comma are dropped if there's no first name - see
 * eiw_core_node_presave()), rendered as a link to the record. Tagging the
 * surname, given name and bracketed date as separate spans (rather than
 * hard-breaking them here) lets the CSS decide when to stack them onto
 * three lines - only once the column's narrow enough that it would
 * otherwise wrap mid-bracket - while leaving them to wrap normally at
 * wider widths (see .views-field-title in _wills.scss).
 */
function eastindiawills_unb_lib_ca_preprocess_views_view_field(&$variables) {
  if ($variables['view']->id() !== 'wills' || $variables['field']->field !== 'title') {
    return;
  }
  $variables['output'] = Markup::create(preg_replace_callback(
    '#(<a\b[^>]*>)(.*?)(</a>)#s',
    function (array $matches) {
      $text = trim(strip_tags($matches[2]));
      if (!preg_match('/^(.*?)(\s*\[[^\]]*\]\s*)$/', $text, $parts)) {
        return $matches[0];
      }
      $name = trim($parts[1]);
      $date = trim($parts[2]);
      $comma_pos = strpos($name, ',');
      $name_html = $comma_pos === FALSE
        ? '<span class="eiw-title__surname">' . Html::escape($name) . '</span>'
        : '<span class="eiw-title__surname">' . Html::escape(substr($name, 0, $comma_pos + 1)) . '</span> '
          . '<span class="eiw-title__given">' . Html::escape(trim(substr($name, $comma_pos + 1))) . '</span>';
      return $matches[1] . $name_html . ' <span class="eiw-title__date">' . Html::escape($date) . '</span>' . $matches[3];
    },
    (string) $variables['output']
  ));
}

/**
 * Implements hook_preprocess_HOOK() for node.html.twig.
 *
 * Will, voyage and ship pages share one record design (.eiw-record in
 * _records.scss): uppercase field labels over hairline row dividers. Voyages
 * and ships are a single column of fields; wills are two columns (see
 * node--eiw-will--full.html.twig), each column styled the same way.
 */
function eastindiawills_unb_lib_ca_preprocess_node(&$variables) {
  if ($variables['view_mode'] !== 'full') {
    return;
  }
  $node = $variables['node'];
  if (in_array($node->bundle(), ['eiw_voyage', 'eiw_ship'], TRUE)) {
    $variables['content_attributes']['class'][] = 'eiw-record';
  }
  elseif ($node->bundle() === 'eiw_will') {
    _eastindiawills_unb_lib_ca_preprocess_will($variables);
  }
}

/**
 * Prepares a will's full page (node--eiw-will--full.html.twig).
 *
 * - eiw_testator: the given name and surname, for the sidebar.
 * - eiw_citation: the parts of a "cite this record" line; the access date is
 *   filled in by eiw-citation.js, so cached pages don't carry a stale one.
 *
 * @param array $variables
 *   The node template variables.
 */
function _eastindiawills_unb_lib_ca_preprocess_will(array &$variables) {
  $node = $variables['node'];

  // Year-only dates are already shown as just the year by
  // eiw_core_preprocess_node(), so the template leaves out the yes/no
  // "Year only" fields.
  $variables['eiw_testator'] = trim(implode(' ', array_filter([
    $node->get('field_first_name')->value,
    $node->get('field_last_name')->value,
  ])));

  $url = $node->toUrl('canonical', ['absolute' => TRUE])->toString(TRUE);
  $variables['eiw_citation'] = [
    'title' => $node->label(),
    'site' => t('Wills of the East India Company'),
    'url' => $url->getGeneratedUrl(),
  ];
  CacheableMetadata::createFromRenderArray($variables)
    ->addCacheableDependency($url)
    ->applyTo($variables);
}

/**
 * Implements hook_preprocess_HOOK() for field.html.twig.
 *
 * Record fields (wills, voyages, ships and their paragraphs):
 * - Plain text notes (basic_string): one paragraph per line, and a leading
 *   "Label: " on a line becomes a run-in label (.eiw-runin).
 * - Formatted text (text_default) and notes: source URLs become "Source"
 *   links (see _eastindiawills_unb_lib_ca_source_links()).
 * - A voyage's ship names link to their Ship pages.
 */
function eastindiawills_unb_lib_ca_preprocess_field(&$variables) {
  $element = $variables['element'];

  // The itinerary table leaves out columns the viewer can't see (private
  // notes), rather than showing a column of dashes.
  if ($element['#field_name'] === 'field_voyage_stops') {
    $first_stop = $element['#items']->first()?->entity;
    $variables['eiw_denied_columns'] = $first_stop
      ? _eastindiawills_unb_lib_ca_denied_columns($first_stop, $variables)
      : [];
  }

  if (!_eastindiawills_unb_lib_ca_is_record_field($element)) {
    return;
  }

  if ($element['#field_name'] === 'field_voyage_ships') {
    _eastindiawills_unb_lib_ca_link_ship_names($variables);
    return;
  }

  if ($element['#formatter'] === 'basic_string') {
    foreach ($element['#items'] as $delta => $item) {
      if (!isset($variables['items'][$delta])) {
        continue;
      }
      $variables['items'][$delta]['content'] = [
        '#type' => 'inline_template',
        '#template' => '{% for line in lines %}<p class="eiw-note">{% if line.label %}<span class="eiw-runin">{{ line.label }}</span> {% endif %}{{ line.text }}</p>{% endfor %}',
        '#context' => ['lines' => _eastindiawills_unb_lib_ca_note_lines((string) $item->value)],
      ];
    }
    return;
  }

  // "Source" chips are for the migrated voyage and ship research. A will's
  // formatted text (transcription, summary, health notes) is entered by
  // hand, so it's shown exactly as entered, links included.
  if ($element['#formatter'] === 'text_default' && $element['#bundle'] !== 'eiw_will') {
    foreach ($element['#items'] as $delta => $item) {
      if (!isset($variables['items'][$delta])) {
        continue;
      }
      $content = &$variables['items'][$delta]['content'];
      if (($content['#type'] ?? NULL) === 'processed_text') {
        $content = _eastindiawills_unb_lib_ca_processed_text_with_sources((string) $content['#text'], $content['#format'], $content['#langcode'] ?? $item->getLangcode());
      }
      unset($content);
    }
  }
}

/**
 * Implements hook_preprocess_HOOK() for paragraph.html.twig.
 *
 * Itinerary table rows leave out the same columns as the table header (see
 * eastindiawills_unb_lib_ca_preprocess_field()).
 */
function eastindiawills_unb_lib_ca_preprocess_paragraph(&$variables) {
  if ($variables['paragraph']->bundle() === 'eiw_voyage_stop' && $variables['view_mode'] === 'table_row') {
    $variables['eiw_denied_columns'] = _eastindiawills_unb_lib_ca_denied_columns($variables['paragraph'], $variables);
  }
  if ($variables['paragraph']->bundle() === 'eiw_ship_identity') {
    _eastindiawills_unb_lib_ca_preprocess_ship_identity($variables);
  }
}

/**
 * Adds a ship identity's service years and type picture to its template.
 *
 * - eiw_years: "1622–1631" (or one year) from In Service From/To, shown
 *   beside the ship's name.
 * - eiw_type_image, eiw_type_caption: for a ship with no picture of its
 *   own, its type's representative picture and caption (from the Ship types
 *   term), shown in the same place and size as an own picture would be.
 *
 * @param array $variables
 *   The paragraph template variables.
 */
function _eastindiawills_unb_lib_ca_preprocess_ship_identity(array &$variables): void {
  $paragraph = $variables['paragraph'];

  $from = $paragraph->get('field_service_from')->value;
  $to = $paragraph->get('field_service_to')->value;
  $variables['eiw_years'] = ($from && $to && $from != $to) ? "{$from}–{$to}" : ($from ?: $to);

  if (!$paragraph->get('field_image')->isEmpty()) {
    return;
  }
  $type = $paragraph->get('field_vessel_type')->entity;
  if (!$type || !$type->hasField('field_image') || $type->get('field_image')->isEmpty()) {
    return;
  }
  // The type's picture is formatted like the identity's own would be.
  $display = \Drupal::service('entity_display.repository')
    ->getViewDisplay('paragraph', 'eiw_ship_identity', $variables['view_mode']);
  $image_options = $display->getComponent('field_image') ?? ['type' => 'image'];
  $variables['eiw_type_image'] = $type->get('field_image')->view(['label' => 'hidden'] + $image_options);
  $variables['eiw_type_caption'] = $type->get('field_image_caption')->view(['label' => 'hidden', 'type' => 'text_default']);
  CacheableMetadata::createFromRenderArray($variables)
    ->addCacheableDependency($type)
    ->applyTo($variables);
}

/**
 * Lists a voyage stop's table columns that the current user may not view.
 *
 * Only the notes columns are access-controlled (field_notes is editors-only;
 * see eiw_core_entity_field_access()). The access results' cacheability is
 * added to $variables, so the table varies by permissions.
 *
 * @param \Drupal\Core\Entity\FieldableEntityInterface $stop
 *   A voyage stop paragraph.
 * @param array $variables
 *   The template variables, to receive the cacheability metadata.
 *
 * @return string[]
 *   Column names ("notes", "notes_public") the user can't view.
 */
function _eastindiawills_unb_lib_ca_denied_columns(FieldableEntityInterface $stop, array &$variables): array {
  $denied = [];
  $cacheability = CacheableMetadata::createFromRenderArray($variables);
  foreach (['notes_public', 'notes'] as $column) {
    if (!$stop->hasField('field_' . $column)) {
      continue;
    }
    $access = $stop->get('field_' . $column)->access('view', NULL, TRUE);
    $cacheability->addCacheableDependency($access);
    if (!$access->isAllowed()) {
      $denied[] = $column;
    }
  }
  $cacheability->applyTo($variables);
  return $denied;
}

/**
 * Links a voyage's ship names to their Ship pages.
 *
 * field_voyage_ships keeps the fleet's names as researched, since many of
 * its ships have no Ship record. A name matching a Ship's title (ignoring
 * case) that the viewer can see links to it; the others stay text. The
 * field varies with the Ship list, so it's cached against it.
 *
 * @param array $variables
 *   The field template variables.
 */
function _eastindiawills_unb_lib_ca_link_ship_names(array &$variables): void {
  $cacheability = CacheableMetadata::createFromRenderArray($variables)
    ->addCacheTags(['node_list:eiw_ship']);
  $names = [];
  foreach ($variables['element']['#items'] as $item) {
    $names[] = (string) $item->value;
  }
  $ships = [];
  if ($names) {
    $storage = \Drupal::entityTypeManager()->getStorage('node');
    $ids = $storage->getQuery()
      ->accessCheck(TRUE)
      ->condition('type', 'eiw_ship')
      ->condition('title', $names, 'IN')
      ->execute();
    foreach ($storage->loadMultiple($ids) as $ship) {
      $ships[mb_strtolower($ship->label())] = $ship;
    }
  }
  foreach ($names as $delta => $name) {
    $ship = $ships[mb_strtolower($name)] ?? NULL;
    if ($ship && isset($variables['items'][$delta])) {
      $variables['items'][$delta]['content'] = [
        '#type' => 'link',
        '#title' => $name,
        '#url' => $ship->toUrl(),
      ];
      $cacheability->addCacheableDependency($ship);
    }
  }
  $cacheability->applyTo($variables);
}

/**
 * Whether a field belongs to one of the East India Wills record entities.
 *
 * @param array $element
 *   The field render element.
 */
function _eastindiawills_unb_lib_ca_is_record_field(array $element): bool {
  return in_array($element['#entity_type'] ?? '', ['node', 'paragraph'], TRUE)
    && str_starts_with($element['#bundle'] ?? '', 'eiw_');
}

/**
 * Splits plain-text notes into lines, separating any leading run-in label.
 *
 * A label is a short phrase followed by ": " at the start of a line:
 * "Ships identified: ...", "Confidence: ...", "Hector (1): arr. ...". It
 * starts with a letter, runs to at most 40 characters and six words, and
 * has no sentence punctuation, quotes or unclosed brackets, so prose that
 * happens to contain a colon ("Capt. Smith: ...", "Usually 'the Hope'
 * (Foster: ...") is left as text.
 *
 * @param string $text
 *   The plain-text field value.
 *
 * @return array
 *   One ['label' => ?string, 'text' => string] per non-empty line.
 */
function _eastindiawills_unb_lib_ca_note_lines(string $text): array {
  $lines = [];
  foreach (preg_split('/\R/u', $text) as $line) {
    $line = trim($line);
    if ($line === '') {
      continue;
    }
    if (preg_match('/^(\p{L}(?:[^:.;,!?"\'()]|\([^():]*\))*):\s+(\S.*)$/u', $line, $matches)
      && mb_strlen($matches[1]) <= 40
      && count(preg_split('/\s+/u', trim($matches[1]))) <= 6) {
      $lines[] = [
        'label' => trim($matches[1]),
        'text' => _eastindiawills_unb_lib_ca_link_urls(_eastindiawills_unb_lib_ca_capitalize($matches[2])),
      ];
    }
    else {
      $lines[] = ['label' => NULL, 'text' => _eastindiawills_unb_lib_ca_link_urls($line)];
    }
  }
  return $lines;
}

/**
 * Escapes plain text and links its web addresses as "Source".
 *
 * @param string $text
 *   Plain text.
 *
 * @return \Drupal\Core\Render\Markup
 *   The escaped text, with its URLs as links (see
 *   _eastindiawills_unb_lib_ca_source_links()).
 */
function _eastindiawills_unb_lib_ca_link_urls(string $text): Markup {
  return Markup::create(_eastindiawills_unb_lib_ca_source_links(Html::escape($text)));
}

/**
 * Links the web addresses in record text as "Source" chips.
 *
 * Migrated voyage and ship research cites its sources by URL: bare in voyage
 * descriptions and in notes ("Source: Markham (ed.), ...
 * https://archive.org/details/..."), and as links showing their own address
 * in ship sources. The citation already says what the source is, so each
 * address becomes a small "Source" link (.eiw-source, styled in
 * _records.scss):
 * - a bare http(s) URL outside a link is linked, leaving any trailing
 *   punctuation (or an unmatched closing bracket) outside the link;
 * - a link whose text is a URL is relabelled.
 * Links with their own text ("Rijksmuseum, Amsterdam (RP-P-OB-11.345)")
 * are left alone. Each link also names its site for screen readers ("Source:
 * archive.org"), so a line citing several sources doesn't read as a row of
 * identical "Source" links.
 *
 * Formatted text must already be filtered by its text format (see
 * _eastindiawills_unb_lib_ca_processed_text_with_sources()), whose HTML
 * filter would otherwise strip the class.
 *
 * @param string $html
 *   A safe HTML fragment: filtered formatted text or escaped plain text.
 *
 * @return string
 *   The fragment with its source URLs as "Source" links.
 */
function _eastindiawills_unb_lib_ca_source_links(string $html): string {
  if (stripos($html, 'http') === FALSE) {
    return $html;
  }
  $label = (string) t('Source');
  $dom = Html::load($html);
  $xpath = new \DOMXPath($dom);

  foreach (iterator_to_array($xpath->query('//a[@href]')) as $link) {
    if (preg_match('#^\s*(https?://|www\.)#i', $link->textContent)) {
      while ($link->firstChild) {
        $link->removeChild($link->firstChild);
      }
      _eastindiawills_unb_lib_ca_source_link_label($link, $label);
    }
  }

  foreach (iterator_to_array($xpath->query('//body//text()[not(ancestor::a)]')) as $node) {
    $parts = preg_split('#(https?://[^\s<>"\']+)#i', $node->nodeValue, -1, PREG_SPLIT_DELIM_CAPTURE);
    if (count($parts) === 1) {
      continue;
    }
    $fragment = $dom->createDocumentFragment();
    foreach ($parts as $i => $part) {
      if ($i % 2 === 0) {
        if ($part !== '') {
          $fragment->appendChild($dom->createTextNode($part));
        }
        continue;
      }
      // Trailing punctuation ends the sentence, not the URL; so does a
      // closing bracket the URL didn't open ("(see https://...)").
      $trail = '';
      while (preg_match('/[.,;:!?)\]]$/', $part)) {
        $last = substr($part, -1);
        $open = $last === ')' ? '(' : ($last === ']' ? '[' : NULL);
        if ($open !== NULL && substr_count($part, $open) >= substr_count($part, $last)) {
          break;
        }
        $trail = $last . $trail;
        $part = substr($part, 0, -1);
      }
      $link = $dom->createElement('a');
      $link->setAttribute('href', $part);
      _eastindiawills_unb_lib_ca_source_link_label($link, $label);
      $fragment->appendChild($link);
      if ($trail !== '') {
        $fragment->appendChild($dom->createTextNode($trail));
      }
    }
    $node->parentNode->replaceChild($fragment, $node);
  }

  return Html::serialize($dom);
}

/**
 * Gives an empty link the "Source" chip label and class.
 *
 * @param \DOMElement $link
 *   An <a> element with an href and no content.
 * @param string $label
 *   The visible label ("Source").
 */
function _eastindiawills_unb_lib_ca_source_link_label(\DOMElement $link, string $label): void {
  $dom = $link->ownerDocument;
  $classes = trim($link->getAttribute('class') . ' eiw-source');
  $link->setAttribute('class', $classes);
  $link->appendChild($dom->createTextNode($label));
  $host = preg_replace('/^www\./i', '', (string) parse_url($link->getAttribute('href'), PHP_URL_HOST));
  if ($host !== '') {
    $hidden = $dom->createElement('span');
    $hidden->setAttribute('class', 'visually-hidden');
    $hidden->appendChild($dom->createTextNode(': ' . $host));
    $link->appendChild($hidden);
  }
}

/**
 * Filters formatted text by its text format, then adds its "Source" links.
 *
 * The links' class and screen-reader text are added after filtering, since
 * the format's HTML filter allows only <a href>.
 *
 * @param string $text
 *   The unfiltered formatted text.
 * @param string|null $format
 *   The text format ID.
 * @param string $langcode
 *   The text's language.
 *
 * @return array
 *   A render array, carrying the text format's cacheability and assets.
 */
function _eastindiawills_unb_lib_ca_processed_text_with_sources(string $text, ?string $format, string $langcode): array {
  $processed = [
    '#type' => 'processed_text',
    '#text' => $text,
    '#format' => $format,
    '#langcode' => $langcode,
  ];
  $html = (string) \Drupal::service('renderer')->renderInIsolation($processed);
  $build = ['#markup' => Markup::create(_eastindiawills_unb_lib_ca_source_links($html))];
  BubbleableMetadata::createFromRenderArray($processed)->applyTo($build);
  return $build;
}

/**
 * Capitalizes the first letter of text following a run-in label.
 *
 * "CONFIDENCE confirmed." reads as a fragment; "CONFIDENCE Confirmed." as
 * a labelled value. Leading whitespace is kept.
 *
 * @param string $text
 *   The text after the label.
 */
function _eastindiawills_unb_lib_ca_capitalize(string $text): string {
  return preg_replace_callback('/^(\s*)(\p{Ll})/u', fn(array $m) => $m[1] . mb_strtoupper($m[2]), $text);
}
