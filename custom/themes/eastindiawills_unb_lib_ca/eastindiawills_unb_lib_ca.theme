<?php

use Drupal\Component\Utility\Html;
use Drupal\Core\Render\Markup;

/**
 * @file
 * East India Wills theme file.
 */

/**
 * Implements hook_views_post_render().
 */
function eastindiawills_unb_lib_ca_views_post_render($view, &$output, &$cache) {
  if ($view->id() === 'audit_wills' && $view->current_display === 'page_1') {
    // If there are no results.
    if (empty($view->result)) {
      // Override the title after all other processing.
      $view->setTitle('Audit Wills');
      // You may also need to directly override $output['#title'] if the above doesn't work:
      $output['#title'] = 'Audit Wills';
    }
  }
}
/**
 * Implements hook_preprocess_HOOK() for menu--main.html.twig.
 *
 * Marks main menu links pointing at the current route as active, so the
 * header can underline the current section regardless of query strings
 * (e.g. facet filters on /wills).
 */
function eastindiawills_unb_lib_ca_preprocess_menu__main(&$variables) {
  $current_route = \Drupal::routeMatch()->getRouteName();
  foreach ($variables['items'] as &$item) {
    if ($item['url']->isRouted() && $item['url']->getRouteName() === $current_route) {
      $item['in_active_trail'] = TRUE;
    }
  }
  $variables['#cache']['contexts'][] = 'route.name';
}

/**
 * Implements hook_preprocess_HOOK() for page.html.twig.
 *
 * The wills search page follows the concept design: no breadcrumb.
 *
 * The hero engraving (see page.html.twig's eiw_hero block) belongs on the
 * homepage per the concept design - specifically the landing page node
 * eiw_core creates (EIW_CORE_LANDING_PAGE_UUID), not just any node of its
 * "page" type (e.g. a future "About this site" page shouldn't get it too).
 */
function eastindiawills_unb_lib_ca_preprocess_page(&$variables) {
  $route_match = \Drupal::routeMatch();
  if ($route_match->getRouteName() === 'view.wills.page_1') {
    unset($variables['page']['breadcrumb']);
  }
  elseif ($route_match->getRouteName() === 'entity.node.canonical') {
    $node = $route_match->getParameter('node');
    if ($node instanceof \Drupal\node\NodeInterface && $node->uuid() === EIW_CORE_LANDING_PAGE_UUID) {
      $variables['eiw_hero'] = TRUE;
    }
  }
  $variables['#cache']['contexts'][] = 'route.name';
}

/**
 * Implements hook_preprocess_HOOK() for views-view-field.html.twig.
 *
 * The wills listing's title is always "{Surname}, {Given name} [ {date} ]"
 * (the given name and comma are dropped if there's no first name - see
 * eiw_core_node_presave()), rendered as a link to the record. Tagging the
 * surname, given name and bracketed date as separate spans (rather than
 * hard-breaking them here) lets the CSS decide when to stack them onto
 * three lines - only once the column's narrow enough that it would
 * otherwise wrap mid-bracket - while leaving them to wrap normally at
 * wider widths (see .views-field-title in _wills.scss).
 */
function eastindiawills_unb_lib_ca_preprocess_views_view_field(&$variables) {
  if ($variables['view']->id() !== 'wills' || $variables['field']->field !== 'title') {
    return;
  }
  $variables['output'] = Markup::create(preg_replace_callback(
    '#(<a\b[^>]*>)(.*?)(</a>)#s',
    function (array $matches) {
      $text = trim(strip_tags($matches[2]));
      if (!preg_match('/^(.*?)(\s*\[[^\]]*\]\s*)$/', $text, $parts)) {
        return $matches[0];
      }
      $name = trim($parts[1]);
      $date = trim($parts[2]);
      $comma_pos = strpos($name, ',');
      $name_html = $comma_pos === FALSE
        ? '<span class="eiw-title__surname">' . Html::escape($name) . '</span>'
        : '<span class="eiw-title__surname">' . Html::escape(substr($name, 0, $comma_pos + 1)) . '</span> '
          . '<span class="eiw-title__given">' . Html::escape(trim(substr($name, $comma_pos + 1))) . '</span>';
      return $matches[1] . $name_html . ' <span class="eiw-title__date">' . Html::escape($date) . '</span>' . $matches[3];
    },
    (string) $variables['output']
  ));
}
