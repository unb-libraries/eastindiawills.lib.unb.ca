<?php

/**
 * @file
 * East India Wills theme file.
 */

/**
 * Implements hook_views_post_render().
 */
function eastindiawills_unb_lib_ca_views_post_render($view, &$output, &$cache) {
  if ($view->id() === 'audit_wills' && $view->current_display === 'page_1') {
    // If there are no results.
    if (empty($view->result)) {
      // Override the title after all other processing.
      $view->setTitle('Audit Wills');
      // You may also need to directly override $output['#title'] if the above doesn't work:
      $output['#title'] = 'Audit Wills';
    }
  }
}
/**
 * Implements hook_preprocess_HOOK() for menu--main.html.twig.
 *
 * Marks main menu links pointing at the current route as active, so the
 * header can underline the current section regardless of query strings
 * (e.g. facet filters on /wills).
 */
function eastindiawills_unb_lib_ca_preprocess_menu__main(&$variables) {
  $current_route = \Drupal::routeMatch()->getRouteName();
  foreach ($variables['items'] as &$item) {
    if ($item['url']->isRouted() && $item['url']->getRouteName() === $current_route) {
      $item['in_active_trail'] = TRUE;
    }
  }
  $variables['#cache']['contexts'][] = 'route.name';
}

/**
 * Implements hook_preprocess_HOOK() for page.html.twig.
 *
 * The wills search page follows the concept design: a hero engraving above
 * the content, and no breadcrumb.
 */
function eastindiawills_unb_lib_ca_preprocess_page(&$variables) {
  if (\Drupal::routeMatch()->getRouteName() === 'view.wills.page_1') {
    $variables['eiw_hero'] = TRUE;
    unset($variables['page']['breadcrumb']);
  }
  $variables['#cache']['contexts'][] = 'route.name';
}
