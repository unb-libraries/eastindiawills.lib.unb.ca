<?php

/**
 * @file
 * Theme override functions and hooks for eiw_admin_theme.
 */

/**
 * Implements hook_element_info_alter().
 */
function eiw_admin_theme_element_info_alter(array &$info) {
  // Alter datetetime fields.
  $info['datetime']['#process'][] = 'datetime_settings';
}

/**
 * Custom function to alter HTML5 date fields.
 *
 * Applies to every date field rather than an allowlist of field names, to
 * match the server-side year range in eiw_datefix (which validates any date
 * field on any form); otherwise a field left off this list would pass that
 * wider validation but still get clamped by the browser's native widget.
 */
function datetime_settings($element) {
  // Set HTML5 range attributes. Prevents defaulting to loaded value.
  $element['date']['#attributes']['min'] = '1500-01-01';
  $element['date']['#attributes']['max'] = '2100-01-01';

  return $element;
}
